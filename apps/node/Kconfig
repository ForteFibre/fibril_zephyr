menu "fibril_can node"

config APP_WATCHDOG
	bool "Reset the board when the function ticks stop"
	default y
	depends on WATCHDOG
	depends on $(dt_alias_enabled,watchdog0)
	help
	  Start the watchdog0 device just before handing over to the transport
	  and feed it from the function ticks. A tick that stops running then
	  resets the board instead of leaving the last output on the motors.

	  Whether a stalled fcan_poll is caught depends on the transport. The
	  direct transport runs the ticks and fcan_poll on one thread, so
	  either stopping starves the watchdog. Behind a hub, fcan_poll runs on
	  the hub driver's thread and the ticks keep feeding the watchdog
	  without it.

	  An image with no tick has nothing to feed it from, so the watchdog
	  stays off there and says so in the log.

config APP_WATCHDOG_TIMEOUT_MS
	int "Watchdog timeout in milliseconds"
	default 1000
	depends on APP_WATCHDOG
	help
	  1000 is what CanMotorMbed gave the IWDG. The ticks run every
	  millisecond, so this only has to cover how long a tick may
	  legitimately be held up.

config APP_FCAN_HEAP_SIZE
	int "Bytes reserved for the fibril_can node"
	default 16384
	help
	  The node and the arena fcan_init carves its buffers from are both
	  allocated from this heap, once, at boot. The arena grows with the
	  schema's limits and with how many instances the board wires, so the
	  default leaves room for any deployment rather than fitting one.

	  Lower it in a deployment snippet when the board is short of RAM.
	  Enable SYS_HEAP_RUNTIME_STATS to have the node log how much of it
	  the boot actually used. Below that, fcan_init cannot get its arena,
	  logs "fcan_init failed" with the NOMEM fault, and main returns
	  before attaching the transport, so the node never reaches the bus.

endmenu

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"
