/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Board configuration for the Fibril RoboMaster Mini V3. Pin assignments are
 * taken from CanMotorMbed/src/targets/robomaster_miniv3 so that hardware built
 * for that firmware works unmodified. The MCU is an STM32G474MET (LQFP80, M
 * package) — the same die family as miniv1/miniv4 but with fewer pins, so this
 * board uses the M-package pinctrl DTSI. Bus pinouts (USART1 console, USART3
 * RS485 with PB14 DE, FDCAN1 external, FDCAN2 MOTCAN0, FDCAN3 MOTCAN1, USB)
 * match miniv4; miniv3 differs in the RGB LED locations and rotary ID pins.
 */

/dts-v1/;
#include <st/g4/stm32g474Xe.dtsi>
#include <st/g4/stm32g474m(b-c-e)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "Fibril RoboMaster Mini V3";
	compatible = "fibril,robomaster-miniv3";

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	leds: leds {
		compatible = "gpio-leds";

		led_r: led_r {
			gpios = <&gpiob 4 GPIO_ACTIVE_LOW>;
			label = "LED R";
		};

		led_g: led_g {
			gpios = <&gpiod 2 GPIO_ACTIVE_LOW>;
			label = "LED G";
		};

		led_b: led_b {
			gpios = <&gpiob 3 GPIO_ACTIVE_LOW>;
			label = "LED B";
		};
	};

	/* Four-position BCD rotary DIP switch (ROT1|ROT2|ROT4|ROT8, active low).
	 * Read as a nibble to derive per-unit CAN IDs / hostnames, matching the
	 * mbed target's Hardware() constructor. ROT4 (PC14) and ROT8 (PC13)
	 * overlap with the LSE oscillator inputs and SYS_WKUP2 — we don't enable
	 * either, so the pins are free for GPIO. Not a gpio-keys input source.
	 */
	rotary_id: rotary_id {
		compatible = "gpio-keys";
		status = "okay";

		rot1: rot1 {
			label = "ROT1";
			gpios = <&gpioc 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_1>;
		};

		rot2: rot2 {
			label = "ROT2";
			gpios = <&gpioc 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_2>;
		};

		rot4: rot4 {
			label = "ROT4";
			gpios = <&gpioc 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_3>;
		};

		rot8: rot8 {
			label = "ROT8";
			gpios = <&gpioc 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_4>;
		};
	};

	aliases {
		led0 = &led_g;
		watchdog0 = &iwdg;
	};
};

/* HSE 24 MHz crystal -> PLL -> 160 MHz SYSCLK. HSI48 is left on so USB and other
 * 48 MHz peripherals can source from it through CLK48_SEL when needed.
 */
&clk_hse {
	clock-frequency = <DT_FREQ_M(24)>;
	status = "okay";
};

&clk_hsi48 {
	status = "okay";
};

/* PLL_Q is used as the FDCAN kernel clock (see &fdcan1/&fdcan2/&fdcan3 below).
 * We need it at or below FDCAN's 80 MHz ceiling and high enough that the
 * 5 Mbps FD data phase has integer time-quanta per bit. VCO = 24 MHz / div-m *
 * mul-n = 320 MHz, so div-q = 4 lands PLL_Q at 80 MHz — 16 tq @ 5 Mbps, 80 tq
 * @ 1 Mbps. HSE (24 MHz) would leave 4.8 tq/bit at 5 Mbps, not representable.
 */
&pll {
	div-m = <6>;
	mul-n = <80>;
	div-p = <2>;
	div-q = <4>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(160)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

/* Console on the target's default STDIO pins (PA9/PA10 = USART1). */
&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* RS485 bus for the AMT21x encoders. TX=PC10, RX=PC11, DE=PB14. Left disabled
 * here so overlays can add the amt21 child nodes and pick baud / DMA settings.
 */
// &usart3 {
// 	pinctrl-0 = <&usart3_tx_pc10 &usart3_rx_pc11 &usart3_de_pb14>;
// 	pinctrl-names = "default";
// };

/* All three FDCAN kernel-clocks are PLL_Q at 80 MHz — the FDCAN ceiling. That
 * kernel rate is shared across every FDCAN instance on this SoC and is high
 * enough to divide cleanly at both 1 Mbps arbitration (80 tq/bit) and 5 Mbps
 * FD data (16 tq/bit). Overlays only need to flip status to "okay" and set
 * the bitrate.
 */

/* External CAN transceiver on PD0/PD1 (STDBY control on PB11). */
&fdcan1 {
	clocks = <&rcc STM32_CLOCK(APB1, 25)>,
		 <&rcc STM32_SRC_PLL_Q FDCAN_SEL(1)>;
	pinctrl-0 = <&fdcan1_rx_pd0 &fdcan1_tx_pd1>;
	pinctrl-names = "default";
};

/* MOTCAN0 to the first RoboMaster motor bus on PB12/PB13. */
// &fdcan2 {
// 	clocks = <&rcc STM32_CLOCK(APB1, 25)>,
// 		 <&rcc STM32_SRC_PLL_Q FDCAN_SEL(1)>;
// 	pinctrl-0 = <&fdcan2_rx_pb12 &fdcan2_tx_pb13>;
// 	pinctrl-names = "default";
// };

/* MOTCAN1 to the second RoboMaster motor bus on PA8/PA15. */
// &fdcan3 {
// 	clocks = <&rcc STM32_CLOCK(APB1, 25)>,
// 		 <&rcc STM32_SRC_PLL_Q FDCAN_SEL(1)>;
// 	pinctrl-0 = <&fdcan3_rx_pa8 &fdcan3_tx_pa15>;
// 	pinctrl-names = "default";
// };

// zephyr_udc0: &usb {
// 	pinctrl-0 = <&usb_dm_pa11 &usb_dp_pa12>;
// 	pinctrl-names = "default";
// };

&iwdg {
	status = "okay";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(48)>;
			read-only;
		};

		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000c000 DT_SIZE_K(228)>;
		};

		slot1_partition: partition@45000 {
			label = "image-1";
			reg = <0x00045000 DT_SIZE_K(228)>;
		};

		storage_partition: partition@7e000 {
			label = "storage";
			reg = <0x0007e000 DT_SIZE_K(8)>;
		};
	};
};
