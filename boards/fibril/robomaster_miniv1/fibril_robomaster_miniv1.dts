/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Board configuration for the Fibril RoboMaster Mini V1. Pin assignments are
 * taken from CanMotorMbed/src/targets/robomaster_miniv1 so that hardware built
 * for that firmware works unmodified.
 */

/dts-v1/;
#include <st/g4/stm32g474Xe.dtsi>
#include <st/g4/stm32g474v(b-c-e)tx-pinctrl.dtsi>

/ {
	model = "Fibril RoboMaster Mini V1";
	compatible = "fibril,robomaster-miniv1";

	chosen {
		zephyr,console = &usart2;
		zephyr,shell-uart = &usart2;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	leds: leds {
		compatible = "gpio-leds";

		led_r: led_r {
			gpios = <&gpioc 10 GPIO_ACTIVE_LOW>;
			label = "LED R";
		};

		led_g: led_g {
			gpios = <&gpioc 11 GPIO_ACTIVE_LOW>;
			label = "LED G";
		};

		led_b: led_b {
			gpios = <&gpioc 12 GPIO_ACTIVE_LOW>;
			label = "LED B";
		};
	};

	aliases {
		led0 = &led_g;
		watchdog0 = &iwdg;
	};
};

/* HSE 24 MHz crystal -> PLL -> 160 MHz SYSCLK. HSI48 is left on so USB and other
 * 48 MHz peripherals can source from it through CLK48_SEL when needed.
 */
&clk_hse {
	clock-frequency = <DT_FREQ_M(24)>;
	status = "okay";
};

&clk_hsi48 {
	status = "okay";
};

&pll {
	div-m = <6>;
	mul-n = <80>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(160)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

/* Console on the target's STDIO pins (PD5/PD6). */
&usart2 {
	pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* RS485 bus for the AMT21x encoders. TX=PB10, RX=PE15, DE=PB14. Left disabled
 * here so overlays can add the amt21 child nodes and pick baud / DMA settings.
 */
&usart3 {
	pinctrl-0 = <&usart3_tx_pb10 &usart3_rx_pe15 &usart3_de_pb14>;
	pinctrl-names = "default";
};

/* Kernel clock is HSE (24 MHz), which is under the 80 MHz FDCAN ceiling and
 * shared with the other FDCAN instances on this SoC. Overlays only need to
 * flip status to "okay" and set the bitrate.
 */
&fdcan1 {
	clocks = <&rcc STM32_CLOCK(APB1, 25)>,
		 <&rcc STM32_SRC_HSE FDCAN_SEL(0)>;
	pinctrl-0 = <&fdcan1_rx_pd0 &fdcan1_tx_pd1>;
	pinctrl-names = "default";
};

&iwdg {
	status = "okay";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(48)>;
			read-only;
		};

		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000c000 DT_SIZE_K(228)>;
		};

		slot1_partition: partition@45000 {
			label = "image-1";
			reg = <0x00045000 DT_SIZE_K(228)>;
		};

		storage_partition: partition@7e000 {
			label = "storage";
			reg = <0x0007e000 DT_SIZE_K(8)>;
		};
	};
};
