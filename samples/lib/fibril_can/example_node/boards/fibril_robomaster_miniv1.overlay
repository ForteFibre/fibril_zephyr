/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * fibril_can example_node bring-up on the Fibril RoboMaster Mini V1. The board
 * DTS already routes fdcan1 pinctrl to PD0/PD1 and sources its kernel clock
 * from PLL_Q (80 MHz); this overlay just enables the controller, picks a
 * bitrate, publishes it as zephyr,canbus, and turns on the on-chip RNG so
 * fcan_config_t::boot_id has a real entropy source.
 *
 * The board has no software-controlled CAN transceiver standby pin, so no
 * extra GPIO wiring is needed here.
 */

/ {
	chosen {
		zephyr,canbus = &fdcan1;
	};
};

&fdcan1 {
	status = "okay";

	/* 1 Mbps arbitration / 5 Mbps FD data phase. With PLL_Q @ 80 MHz that is
	 * 80 tq @ 1 Mbps and 16 tq @ 5 Mbps -- comfortable margin for the driver's
	 * default sample-point picks. If a deployment needs a different bitrate,
	 * change these two properties only.
	 */
	bitrate = <1000000>;
	bitrate-data = <5000000>;
};

/* sys_rand32_get() in the sample's main.c seeds fcan_config_t::boot_id. The
 * board DTS keeps CLK48_SEL on HSI48 already, so enabling the RNG node is all
 * the extra clocking it needs.
 */
&rng {
	status = "okay";
};
