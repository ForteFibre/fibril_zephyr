&spi0 {
	enc0: as5047p@0 {
		compatible = "ams,as5047p";
		reg = <0>;
		spi-max-frequency = <8000000>;
		poll-interval-us = <1000>;
		offline-threshold = <3>;
	};

	enc1: as5047p@1 {
		compatible = "ams,as5047p";
		reg = <1>;
		spi-max-frequency = <8000000>;
		poll-interval-us = <1000>;
		invert-direction;
	};
};
