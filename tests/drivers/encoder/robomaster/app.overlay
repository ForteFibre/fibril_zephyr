/ {
	test_can0: fake_can0 {
		compatible = "zephyr,fake-can";
		status = "okay";
	};

	robomaster-controller {
		compatible = "dji,robomaster";
		#address-cells = <1>;
		#size-cells = <0>;
		cans = <&test_can0>;
		feedback-timeout-ms = <50>;

		motor1: motor@1 {
			compatible = "dji,robomaster-motor";
			reg = <1>;
			model = "c620";
		};

		motor2: motor@2 {
			compatible = "dji,robomaster-motor";
			reg = <2>;
			model = "c620";
		};

		motor3: motor@3 {
			compatible = "dji,robomaster-motor";
			reg = <3>;
			model = "c620";
		};
	};

	enc1: robomaster-encoder-1 {
		compatible = "dji,robomaster-encoder";
		motor = <&motor1>;
	};

	enc2: robomaster-encoder-2 {
		compatible = "dji,robomaster-encoder";
		motor = <&motor2>;
		invert-direction;
	};
};
