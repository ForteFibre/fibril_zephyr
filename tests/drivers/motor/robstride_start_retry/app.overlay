/ {
	test_can0: fake_can0 {
		compatible = "zephyr,fake-can";
		status = "okay";
	};

	test_can1: fake_can1 {
		compatible = "zephyr,fake-can";
		status = "okay";
	};

	robstride_test: robstride-bus {
		compatible = "robstride,bus";
		#address-cells = <1>;
		#size-cells = <0>;
		cans = <&test_can0 &test_can1>;
		master-can-id = <0xfd>;
		feedback-timeout-ms = <50>;

		motor0: motor@7f {
			compatible = "robstride,motor";
			reg = <0x7f>;
			model = "rs00";
		};
	};
};
